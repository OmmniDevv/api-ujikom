@startuml ERD_SistemPeminjamanAlat
!define TABLE(name,desc) class name as "desc" << (T,#EEEEEE) >>
!define PK(x) <b><u>x</u></b>
!define FK(x) <i>x</i>
!define NOT_NULL(x) x

skinparam classBackgroundColor white
skinparam classBorderColor #333333
skinparam classHeaderBackgroundColor #4A90D9
skinparam classHeaderFontColor white
skinparam classFontSize 12
skinparam classAttributeFontSize 11
skinparam ArrowColor #333333
skinparam ArrowThickness 1.5
skinparam shadowing false
skinparam backgroundColor transparent
skinparam padding 5

hide circle
hide methods

TABLE(users, "users") {
  PK(id) : BIGINT UNSIGNED AI
  --
  NOT_NULL(name) : VARCHAR(255)
  NOT_NULL(email) : VARCHAR(255) UNIQUE
  NOT_NULL(password) : VARCHAR(255)
  NOT_NULL(role) : ENUM(admin,petugas,peminjam)
  no_hp : VARCHAR(255)
  alamat : TEXT
  foto_profile : VARCHAR(255)
  email_verified_at : TIMESTAMP
  remember_token : VARCHAR(100)
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

TABLE(kategori, "kategori") {
  PK(id) : BIGINT UNSIGNED AI
  --
  NOT_NULL(nama_kategori) : VARCHAR(255)
  deskripsi : TEXT
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

TABLE(alat, "alat") {
  PK(id) : BIGINT UNSIGNED AI
  --
  FK(kategori_id) : BIGINT UNSIGNED
  NOT_NULL(nama_alat) : VARCHAR(255)
  NOT_NULL(stok) : INT DEFAULT 0
  NOT_NULL(status_kondisi) : VARCHAR(255)
  deskripsi : TEXT
  gambar : VARCHAR(255)
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

TABLE(peminjaman, "peminjaman") {
  PK(id) : BIGINT UNSIGNED AI
  --
  FK(user_id) : BIGINT UNSIGNED
  NOT_NULL(tgl_pinjam) : DATE
  NOT_NULL(tgl_kembali_plan) : DATE
  NOT_NULL(status) : ENUM(diajukan,dipinjam,dikembalikan,telat)
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

TABLE(detail_pinjam, "detail_pinjam") {
  PK(id) : BIGINT UNSIGNED AI
  --
  FK(peminjaman_id) : BIGINT UNSIGNED
  FK(alat_id) : BIGINT UNSIGNED
  NOT_NULL(jumlah) : INT DEFAULT 1
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

TABLE(pengembalian, "pengembalian") {
  PK(id) : BIGINT UNSIGNED AI
  --
  FK(peminjaman_id) : BIGINT UNSIGNED
  FK(petugas_id) : BIGINT UNSIGNED
  NOT_NULL(tgl_kembali) : DATE
  NOT_NULL(kondisi_kembali) : VARCHAR(255)
  NOT_NULL(denda) : INT DEFAULT 0
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

TABLE(log_aktivitas, "log_aktivitas") {
  PK(id) : BIGINT UNSIGNED AI
  --
  FK(user_id) : BIGINT UNSIGNED
  NOT_NULL(aktivitas) : TEXT
  keterangan : TEXT
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

' Relasi
kategori "1" --o{ alat : "memiliki\n(CASCADE DELETE)"
users "1" --o{ peminjaman : "mengajukan\n(CASCADE DELETE)"
peminjaman "1" --o{ detail_pinjam : "terdiri dari\n(CASCADE DELETE)"
alat "1" --o{ detail_pinjam : "digunakan di\n(CASCADE DELETE)"
peminjaman "1" --|| pengembalian : "diproses\n(CASCADE DELETE)"
users "1" --o{ pengembalian : "diverifikasi oleh\n(petugas_id)"
users "1" --o{ log_aktivitas : "mencatat\n(CASCADE DELETE)"

@enduml
